{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {"name":"Python Debugger: Current File","type":"debugpy","request":"launch","program":"${file}","console":"integratedTerminal","env":{"PYTHONPYCACHEPREFIX":"${workspaceFolder}/.pycache"}},
        {
            "name": "Demo: cofy-api (Python)",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/packages/api/.venv/bin/python",
            "module": "uvicorn",
            "args": [
                "demo_cofy_api.main:app",
                "--reload",
                "--app-dir",
                "apps"
            ],
            "jinja": true,
            "envFile": "${workspaceFolder}/.env.local",
            "env": {
                "PYTHONPYCACHEPREFIX": "${workspaceFolder}/.pycache"
            },
            "justMyCode": false
        },
        {
            "name": "Demo: cofy-api (settings)",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/packages/api/.venv/bin/python",
            "module": "uvicorn",
            "args": [
                "demo_cofy_api_settings.main:app",
                "--reload",
                "--app-dir",
                "apps"
            ],
            "jinja": true,
            "envFile": "${workspaceFolder}/.env.local",
            "env": {
                "PYTHONPYCACHEPREFIX": "${workspaceFolder}/.pycache"
            },
            "justMyCode": false
        },
        {
            "name": "Demo: multitenant (management API)",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/packages/management-api/.venv/bin/python",
            "module": "uvicorn",
            "args": [
                "cofy.management.main:app",
                "--reload"
            ],
            "jinja": true,
            "envFile": "${workspaceFolder}/.env.local",
            "env": {
                "PYTHONPYCACHEPREFIX": "${workspaceFolder}/.pycache",
                "COFY_MANAGEMENT_DATA_DIR": "${workspaceFolder}/apps/demo_multitenant/.data"
            },
            "justMyCode": false
        },
        {
            "name": "Demo: multitenant (console)",
            "type": "node-terminal",
            "request": "launch",
            "command": "task demo-multitenant-web",
            "cwd": "${workspaceFolder}"
        }
    ],
    "compounds": [
        {
            "name": "Demo: multitenant (API + console)",
            "configurations": [
                "Demo: multitenant (management API)",
                "Demo: multitenant (console)"
            ],
            "stopAll": true
        }
    ]
}