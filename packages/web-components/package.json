{
  "name": "@cofy/web-components",
  "version": "0.0.0",
  "description": "Lit components for building a Cofy management console.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    },
    "./theme/syntax.css": "./dist/theme/syntax.css"
  },
  "files": [
    "dist",
    "locales"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/EnergieID/cofy-api",
    "directory": "packages/web-components"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build --config vite.build.config.ts && cp src/theme/syntax.css dist/theme/syntax.css",
    "check": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "eslint . --fix",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.39.2",
    "@lezer/highlight": "^1.2.3",
    "@lit/context": "^1.1.6",
    "codemirror": "^6.0.2",
    "i18next": "^26.4.2",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@awesome.me/webawesome": "^3.12.0",
    "@cofy/frontend-sdk": "^0.0.0",
    "@dodona/lit-state": "^1.3.0",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@awesome.me/webawesome": "^3.12.0",
    "@cofy/frontend-sdk": "file:../frontend-sdk",
    "@dodona/lit-state": "^1.3.0",
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9.0.0",
    "jsdom": "^30.0.1",
    "lit": "^3.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
