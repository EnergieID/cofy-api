{
  "name": "@cofy/web-components",
  "version": "0.0.0",
  "description": "Lit components for building a Cofy management console.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/components/*.js",
    "./dist/index.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/EnergieID/cofy-api",
    "directory": "packages/web-components"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "eslint . --fix",
    "test": "vitest run"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/lint": "^6.9.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.39.2",
    "@lit/context": "^1.1.6",
    "codemirror": "^6.0.2",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@carbon/web-components": "^2.62.0",
    "@cofy/frontend-sdk": "^0.0.0",
    "@dodona/lit-state": "^1.3.0",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@carbon/web-components": "^2.63.0",
    "@cofy/frontend-sdk": "file:../frontend-sdk",
    "@dodona/lit-state": "^1.3.0",
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "jsdom": "^30.0.1",
    "lit": "^3.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
