# used to get dat from ENTSOE,create your own token https://transparencyplatform.zendesk.com/hc/en-us/articles/12845911031188-How-to-get-security-token
ENTSOE_API_KEY=<YOUR_API_KEY_HERE>
# used to get production data from EnergyID, this is a personal API key of the user with access to the given record
# create your key in your account at https://app.energyid.eu/account/settings
ENERGY_ID_API_KEY=<YOUR_API_KEY_HERE>
# this is the record ID of the EnergyID record you want to access, you can find it in the URL of the record, e.g. https://app.energyid.eu/record/<RECORD_ID_HERE>
ENERGY_ID_RECORD_ID=<YOUR_RECORD_ID_HERE>
# Google service-account credentials JSON provided by ACC for its Connection Usage Service, on a single line
ACC_CREDENTIALS=<YOUR_CREDENTIALS_JSON_HERE>
# EAN18 code of a connection whose ACC forecasts feed the simultaneity directive
ACC_EAN_1=<YOUR_EAN_HERE>
# this is the token that you will need to access your Cofy API, set it to a secure random value in production
COFY_API_TOKEN=<YOUR_TOKEN_HERE>
# enables per-request profiling at /debug/<id>/profile, keep it off in production unless you are debugging something
COFY_DEBUG=false
# where the management API keeps its data, as an absolute path; the multitenant demo's is apps/demo_multitenant/.data/management
COFY_MANAGEMENT_DATA_DIR=<ABSOLUTE_PATH_TO_THIS_REPO>/apps/demo_multitenant/.data/management
# where the management API keeps the community configs, which the runner serves; may be anywhere, apart from the rest
COFY_MANAGEMENT_COMMUNITIES_DIR=<ABSOLUTE_PATH_TO_THIS_REPO>/apps/demo_multitenant/.data/communities
# the OpenID Connect provider the management API logs people in through; these are the local one from `task dev-idp`,
# see packages/management-api/README.md to use another
COFY_MANAGEMENT_OIDC_ISSUER=http://localhost:8081
COFY_MANAGEMENT_OIDC_CLIENT_ID=cofy-management
COFY_MANAGEMENT_OIDC_CLIENT_SECRET=cofy-management-secret
# signs the management console's session cookies, set it to a long random value in production
COFY_MANAGEMENT_SESSION_SECRET=local-development-only
# the local identity provider is plain http, so the session cookie must be allowed over it; keep it true in production
COFY_MANAGEMENT_SECURE_COOKIES=false
# where the communities' APIs are served, each under its slug: the console links to them, and the management API asks
# them how they are doing; locally, this is `task demo-multitenant-runner`
COFY_MANAGEMENT_COMMUNITIES_URL=http://localhost:8001
# the community settings the runner serves, as an absolute path; the same as COFY_MANAGEMENT_COMMUNITIES_DIR
COFY_RUNNER_DIRECTORY=<ABSOLUTE_PATH_TO_THIS_REPO>/apps/demo_multitenant/.data/communities
